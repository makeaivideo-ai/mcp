{
  "name": "@makeaivideo/mcp",
  "version": "1.0.2",
  "mcpName": "ai.makeaivideo/video-generator",
  "description": "MakeAIVideo MCP server (AI video generator for Claude, ChatGPT, Cursor and any MCP client): create finished AI videos with voiceover, scenes, captions and music, then post them to TikTok, Instagram, YouTube and other connected social accounts. 44 tools.",
  "type": "module",
  "bin": {
    "makeaivideo-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "llms-install.md",
    "server.json",
    "tools.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "makeaivideo",
    "ai-video",
    "ai-video-generator",
    "text-to-video",
    "video-generation",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "chatgpt",
    "ai-agents",
    "tiktok",
    "instagram-reels",
    "youtube-shorts",
    "faceless-video",
    "social-media-automation",
    "social-media-posting",
    "auto-post",
    "video-publishing",
    "generative-ai"
  ],
  "author": "MakeAIVideo <support@makeaivideo.ai> (https://makeaivideo.ai)",
  "license": "MIT",
  "homepage": "https://makeaivideo.ai/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makeaivideo-ai/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/makeaivideo-ai/mcp/issues",
    "email": "support@makeaivideo.ai"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
