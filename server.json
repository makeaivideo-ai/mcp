{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.makeaivideo/video-generator",
  "title": "MakeAIVideo",
  "description": "AI video generator: make TikTok, Reels and Shorts videos with voiceover and captions, and post them.",
  "version": "1.4.4",
  "websiteUrl": "https://makeaivideo.ai/docs/mcp",
  "icons": [
    {
      "src": "https://app.makeaivideo.ai/brand/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/makeaivideo-ai/mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.makeaivideo.ai"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@makeaivideo/mcp",
      "version": "1.0.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MAKEAIVIDEO_API_KEY",
          "description": "Your MakeAIVideo API key (mav_...), from https://app.makeaivideo.ai/developers",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
